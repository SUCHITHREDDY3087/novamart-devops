# =============================================================================
# NovaMart Environment Configuration Template (.env.example)
# Safe to commit into version control. Copy to .env for local deployment.
# =============================================================================

# Database Configuration (MySQL 8)
MYSQL_ROOT_PASSWORD=novamart_secure_root_pass
MYSQL_DATABASE=ecommerce_db
MYSQL_USER=ecommerce_user
MYSQL_PASSWORD=novamart_secure_user_pass

# Backend Connection Configuration
DB_HOST=db
DB_PORT=3306
PORT=5000
FLASK_ENV=production
CORS_ORIGIN=*

# Frontend Host Port
FRONTEND_PORT=80

# Supabase Cloud Database Configuration (Optional Cloud Database Engine)
SUPABASE_URL=
SUPABASE_KEY=

# Application signing secret (replace before any public deployment)
SECRET_KEY=replace_with_a_long_random_secret
